DB_HOST=localhost
DB_PORT=3306
DB_USER=
DB_PASSWORD=
DB_NAME=

# At least 32 characters. Generate: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=
# Access token lifetime in seconds (900 = 15 minutes)
JWT_EXPIRES_IN=900

STRIPE_SECRET_KEY=
APP_URL=

# Stripe TEST mode only: Dashboard → Developers → API keys → Secret key (starts with sk_test_)
STRIPE_SECRET_KEY=
# Where this API runs; Stripe sends the browser back here after paying
APP_URL=http://localhost:3040

# Frontend addresses allowed to call this API from a browser (CORS), comma-separated
CORS_ORIGIN=http://localhost:3000
