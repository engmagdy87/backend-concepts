{
  "info": {
    "name": "backend-concepts",
    "description": "Local Express learning API: admin products, shop (published), and cart.\n\nCart is one guest basket (`carts`) plus `cart_items`. GET/POST/DELETE `/cart` return items with `cartId`, `productId`, `quantity`, and a nested `product`. Add/remove body is still `{ productId }` (published products only).",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3040"
    },
    {
      "key": "productId",
      "value": "6"
    }
  ],
  "item": [
    {
      "name": "Admin",
      "item": [
        {
          "name": "List products",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/admin/products"
          }
        },
        {
          "name": "Get product by id",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/admin/products/{{productId}}"
          }
        },
        {
          "name": "Add product",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"A book\",\n  \"price\": 19.99,\n  \"description\": \"A useful book\",\n  \"imageUrl\": \"https://example.com/book.png\",\n  \"isPublished\": true\n}"
            },
            "url": "{{baseUrl}}/admin/add-product"
          }
        },
        {
          "name": "Update product",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"A book\",\n  \"price\": 24.99,\n  \"description\": \"A useful book\",\n  \"imageUrl\": \"https://example.com/book.png\",\n  \"isPublished\": true\n}"
            },
            "url": "{{baseUrl}}/admin/products/{{productId}}"
          }
        },
        {
          "name": "Delete product",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"id\": 1\n}"
            },
            "url": "{{baseUrl}}/admin/delete-product"
          }
        }
      ]
    },
    {
      "name": "Shop",
      "item": [
        {
          "name": "List published products",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/shop/products"
          }
        },
        {
          "name": "Get published product by id",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/shop/products/{{productId}}"
          }
        }
      ]
    },
    {
      "name": "Cart",
      "description": "One guest cart. Responses are the item list. Each item includes `cartId`, `productId`, `quantity`, and a nested `product`.",
      "item": [
        {
          "name": "Get cart",
          "request": {
            "method": "GET",
            "header": [],
            "description": "List items in the guest cart. `data` is `[{ id, cartId, productId, quantity, product }]`.",
            "url": "{{baseUrl}}/cart"
          }
        },
        {
          "name": "Add item",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"productId\": {{productId}}\n}"
            },
            "description": "Add one unit of a published product. Repeat to increment quantity. 404 if missing or unpublished. Returns the full item list.",
            "url": "{{baseUrl}}/cart/items"
          }
        },
        {
          "name": "Remove item",
          "request": {
            "method": "DELETE",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"productId\": {{productId}}\n}"
            },
            "description": "Subtract one unit. Drops the line at 0. 400 if productId is not a positive integer.",
            "url": "{{baseUrl}}/cart/items"
          }
        },
        {
          "name": "Clear cart",
          "request": {
            "method": "DELETE",
            "header": [],
            "description": "Empty the guest cart (deletes its items; the cart row stays).",
            "url": "{{baseUrl}}/cart"
          }
        }
      ]
    }
  ]
}
