{
  "info": {
    "name": "backend-concepts",
    "description": "Local Express learning API: admin products, shop (published), and cart.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3040"
    },
    {
      "key": "productId",
      "value": "2"
    }
  ],
  "item": [
    {
      "name": "Admin",
      "item": [
        {
          "name": "List products",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/admin/products"
          }
        },
        {
          "name": "Get product by id",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/admin/products/{{productId}}"
          }
        },
        {
          "name": "Add product",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"A book\",\n  \"price\": 19.99,\n  \"description\": \"A useful book\",\n  \"imageUrl\": \"https://example.com/book.png\",\n  \"isPublished\": true\n}"
            },
            "url": "{{baseUrl}}/admin/add-product"
          }
        },
        {
          "name": "Update product",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"id\": 1,\n  \"title\": \"A book\",\n  \"price\": 24.99,\n  \"description\": \"A useful book\",\n  \"imageUrl\": \"https://example.com/book.png\",\n  \"isPublished\": true\n}"
            },
            "url": "{{baseUrl}}/admin/update-product"
          }
        },
        {
          "name": "Delete product",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"id\": 1\n}"
            },
            "url": "{{baseUrl}}/admin/delete-product"
          }
        }
      ]
    },
    {
      "name": "Shop",
      "item": [
        {
          "name": "List published products",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/shop/products"
          }
        },
        {
          "name": "Get published product by id",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/shop/products/{{productId}}"
          }
        }
      ]
    },
    {
      "name": "Cart",
      "item": [
        {
          "name": "Get cart",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/cart"
          }
        },
        {
          "name": "Add item",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"productId\": 2\n}"
            },
            "url": "{{baseUrl}}/cart/items"
          }
        },
        {
          "name": "Remove item",
          "request": {
            "method": "DELETE",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"productId\": 2\n}"
            },
            "url": "{{baseUrl}}/cart/items"
          }
        },
        {
          "name": "Clear cart",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": "{{baseUrl}}/cart"
          }
        }
      ]
    }
  ]
}
